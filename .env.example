# このファイルを .env にコピーして値を埋める。.env はコミットしないこと。

# --- TTS（音声合成）API ---
TTS_API_URL=https://api.example-tts.com/v1/synthesize
TTS_API_KEY=
TTS_VOICE=ja-JP-Standard-A

# --- 画像生成API（サムネイル・挿絵） ---
IMAGE_GEN_API_URL=https://api.example-imagegen.com/v1/generate
IMAGE_GEN_API_KEY=

# --- ストック映像API（B-roll） ---
STOCK_VIDEO_API_URL=https://api.example-stock.com/v1/search
STOCK_VIDEO_API_KEY=
# 手持ち素材フォルダにフォールバックする場合のパス
LOCAL_ASSETS_DIR=./assets/local

# --- YouTube Data API v3 ---
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# --- YouTube Analytics API ---
YOUTUBE_ANALYTICS_SCOPE=https://www.googleapis.com/auth/yt-analytics.readonly
